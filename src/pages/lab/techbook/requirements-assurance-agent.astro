<Layout title="Requirements Assurance Agent | TechBook | The Lab | Vicus Brits" description="Independent Requirements Assurance Agent instructions for reviewing TechBook Define-phase requirements, acceptance criteria, traceability, and risks.">
  <Header />
  <main id="main">
    <section class="techbook-hero" aria-labelledby="requirements-assurance-agent-title">
      <div class="container">
        <a class="techbook-back" href="/lab/techbook"><ArrowLeft size={18} aria-hidden="true" /> Back to TechBook</a>
        <p class="eyebrow">THE LAB / TECHBOOK / AI SKILLS</p>
        <h1 id="requirements-assurance-agent-title">Requirements Assurance Agent<span>.</span></h1>
        <p class="techbook-lead">Independent requirements review</p>
      </div>
